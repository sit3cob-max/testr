pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Your normal build command here'
            }
        }

        stage('Test') {
            steps {
                echo 'Your normal test command here'
            }
        }

        stage('AI Code Review') {
            steps {
                bat '''
                python ai_code_reviewer_v1.py ^
                  --workspace . ^
                  --config ai_code_reviewer_config.json ^
                  --coverage-file coverage.xml ^
                  --junit-pattern "reports\\TEST-*.xml" ^
                  --fail-build false
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'ai_code_review_report.html,ai_code_review_report.json', allowEmptyArchive: true
            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: '.',
                reportFiles: 'ai_code_review_report.html',
                reportName: 'AI Code Review Report'
            ])
        }
    }
}
