pipeline {
  agent any
  options { skipDefaultCheckout(false); disableConcurrentBuilds() }
  stages {
    stage('Analyze Changed Code') {
      steps {
        bat '''
        python jenkins\\reviewer.py --workspace . --output review-output\\review.json
        '''
      }
    }
    stage('Build Dashboard') {
      steps {
        bat '''
        python review-ui\\build_dashboard.py --input review-output\\review.json --output review-ui\\index.html
        '''
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'review-ui/**,review-output/**', allowEmptyArchive: true
      publishHTML(target: [allowMissing: false, alwaysLinkToLastBuild: true, keepAll: true, reportDir: 'review-ui', reportFiles: 'index.html', reportName: 'Code Review Dashboard'])
    }
  }
}
