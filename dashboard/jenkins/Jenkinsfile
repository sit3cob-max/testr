pipeline {
  agent any
  options { disableConcurrentBuilds() }
  stages {
    stage('Check Changed Code') {
      steps {
        bat '''
        python dashboard\\jenkins\\compliance_agent.py ^
          --workspace . ^
          --output review-output\\review.json ^
          --context 3
        '''
      }
    }
    stage('Build Dashboard') {
      steps {
        bat '''
        python dashboard\\review-ui\\build_dashboard.py ^
          --input review-output\\review.json ^
          --output dashboard\\review-ui\\index.html
        '''
      }
    }
  }
  post {
    always {
      publishHTML(target: [allowMissing: false, alwaysLinkToLastBuild: true, keepAll: true, reportDir: 'dashboard/review-ui', reportFiles: 'index.html', reportName: 'Compliance Dashboard'])
    }
  }
}
